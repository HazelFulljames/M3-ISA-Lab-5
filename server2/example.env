# Copy to .env (or set these in your host's Node.js app settings). Never commit .env.

PORT=3000

# Origin of the server1 web page, e.g. https://yourdomain.xyz  (use * while testing)
ALLOWED_ORIGIN=*

DB_HOST=localhost
DB_PORT=3306
DB_NAME=lab5

# Used ONLY to run CREATE TABLE IF NOT EXISTS
DB_ADMIN_USER=lab5_admin
DB_ADMIN_PASSWORD=PASSWORD_ADMIN

# Used for every query that comes from a client. Has SELECT + INSERT only.
DB_RESTRICTED_USER=lab5_restricted
DB_RESTRICTED_PASSWORD=PASSWORD_RESTRICTED

# SELECT-only account for GET queries.
DB_READ_USER=lab5_reader
DB_READ_PASSWORD=PASSWORD_READER

# CA certificate file for TLS; empty for local MySQL without TLS.
DB_SSL_CA_FILE=
